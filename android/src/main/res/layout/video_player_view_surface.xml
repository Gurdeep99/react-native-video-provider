<?xml version="1.0" encoding="utf-8"?>
<!-- SurfaceView variant, opted into via setUseTextureView(false). Cheaper to
     render than a TextureView but can't be transformed/animated and tends to
     black-flash across a re-parent; only used when the app asks for it. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false" />
